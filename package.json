{
  "name": "crackgames3-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "manage": "vite --config vite.manage.config.ts --configLoader runner --host 127.0.0.1 --port 4174 --open /manage.html",
    "check": "tsc --noEmit",
    "data:validate": "tsx scripts/validate-competition.ts",
    "data:build": "tsx scripts/generate-competition.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm data:build && pnpm check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
